# Copy to .env on the VPS and fill in real values. Never commit the real .env.

# Postgres
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT signing secret (long random string)
JWT_SECRET=change-me

# Super admin account (only account exempt from domain validation)
SUPER_ADMIN_EMAIL=admin@veenagroup.com
SUPER_ADMIN_PASSWORD=change-me

# Let's Encrypt notification email
ACME_EMAIL=you@example.com
